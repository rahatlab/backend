# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas free tier)
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>
MONGODB_DB_NAME=events-platform

# Better Auth
BETTER_AUTH_SECRET=<long-random-string>
BETTER_AUTH_URL=http://localhost:5000

# Comma separated list of allowed client origins
CLIENT_URL=http://localhost:3000

# Our own JWT (protects /api/events, /api/joined ...)
JWT_SECRET=<another-long-random-string>
JWT_EXPIRES_IN=7d

# Google OAuth (optional - leave empty to hide the Google login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
